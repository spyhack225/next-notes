<Project>
  <!--
    Strict by default, everywhere.

    We cannot run this code on Windows before shipping it, so the compiler is the only
    reviewer that sees every line. Anything it can be made to catch, it should catch.

    Two of these are not merely tidiness:
      * CA1304/CA1305/CA1311 (culture-sensitive string ops) catch exactly the class of bug
        that makes the C# dictionary diverge from the Swift one. Measured: 9 of 30 regex
        cases behave differently between .NET and Swift's ICU engine, and culture-sensitive
        casing is the largest fixable slice.
      * CA1416 (platform compatibility) is what enforces the project layout — a project on
        plain `net10.0` gets a build ERROR if it touches a Windows-only API, so the
        platform-neutral core cannot silently acquire a Win32 dependency.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>

    <!-- IL2xxx/IL3xxx diagnostics even though we don't publish AOT: they surface
         reflection that would break single-file publishing. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>

    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <Company>Pivot Studio</Company>
    <Product>Speechify</Product>
    <Copyright>Copyright © Pat Simmons</Copyright>
  </PropertyGroup>
</Project>
