<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>

    <!-- Test projects are not a public API surface, so the rules that police one are pure
         noise here. Relaxed deliberately and narrowly, in the test project only — the
         library keeps the full strict set.
           CS1591  documenting every [Fact] says nothing a reader doesn't already know
           CA1707  Underscored_Test_Names are the near-universal xUnit convention
           CA1716  a DTO named `Case` is clearer than one renamed to dodge a VB keyword
           CA1062  argument validation on test helpers
           CA1034  nested types are how xUnit fixtures are conventionally shaped -->
    <!-- A test project is never trimmed or published, so IL2026 on reflection-based
         JSON is a warning about a scenario that cannot occur here. The analyzer stays
         ON for every shipping project, where it does matter. -->
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1716;CA1062;CA1034</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NextNotes.Dictionary\NextNotes.Dictionary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The single shared contract, referenced by link from the repo root rather than
         copied. A copy would drift, and drift is the exact failure this file prevents. -->
    <None Include="..\..\..\shared\dictionary-test-vectors.json"
          Link="dictionary-test-vectors.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
