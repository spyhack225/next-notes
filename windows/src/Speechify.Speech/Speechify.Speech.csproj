<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Platform-neutral: sherpa-onnx itself is cross-platform, and keeping this off a
         -windows TFM means the model-locating logic stays testable anywhere. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Speechify.Speech</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="org.k2fsa.sherpa.onnx" />
    <!-- A RuntimeIdentifier must be set when publishing, or the native DLLs land in
         runtimes/<rid>/native/ and resolution fails at run time. -->
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Speechify.Abstractions\Speechify.Abstractions.csproj" />
  </ItemGroup>
</Project>
