{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Next Notes benchmark record v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "date",
    "category",
    "status",
    "scope",
    "summary",
    "environment",
    "provenance",
    "metrics",
    "limitations",
    "sources",
    "publication"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,100}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "category": {
      "enum": [
        "asr",
        "dictation",
        "meetings",
        "agent",
        "voice",
        "tts",
        "workflows",
        "models",
        "other"
      ]
    },
    "status": {
      "enum": [
        "measured",
        "partial",
        "failed",
        "blocked",
        "unrun"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value",
          "unit",
          "boundary",
          "samples",
          "aggregation"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "boundary": {
            "type": "string",
            "minLength": 1
          },
          "samples": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "aggregation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved",
        "reviewed_by",
        "reviewed_on"
      ],
      "properties": {
        "approved": {
          "type": "boolean"
        },
        "reviewed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "approved": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "reviewed_by": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_on": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "unrun"
          }
        }
      },
      "then": {
        "properties": {
          "metrics": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
