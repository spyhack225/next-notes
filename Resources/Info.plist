<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Speechify</string>
	<key>CFBundleDisplayName</key>
	<string>Speechify</string>
	<!-- Deliberately space-free and distinct from the existing app's `Speechify`, so that
	     `pkill`/`killall` on either app can never match the other. -->
	<key>CFBundleExecutable</key>
	<string>Speechify</string>
	<!-- Separate from the existing Speechify's com.Speechify.client: distinct TCC identity,
	     distinct preferences domain, no shared state of any kind. -->
	<key>CFBundleIdentifier</key>
	<string>ai.pivotstudio.speechify</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<!-- Lets the dashboard's Clear button call back into the app. A file:// page can't
	     write files or talk to a process, but it can follow a custom-scheme link. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ai.pivotstudio.speechify</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>speechify</string>
			</array>
		</dict>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<!-- A regular app: dock icon, app menu, standard windows. The menu bar item remains
	     for status and the hotkey while you're working elsewhere, but it is secondary. -->
	<key>LSUIElement</key>
	<false/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Speechify listens while you hold the push-to-talk key so it can turn your speech into text.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Speechify transcribes your speech on-device to insert text where you're typing.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Speechify records what you hear during a meeting so it can transcribe the other participants on-device. Audio never leaves this Mac.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Speechify reads your calendar to know when a meeting starts, so it can offer to take notes.</string>
	<key>NSUserNotificationsUsageDescription</key>
	<string>Speechify notifies you before a meeting recording starts and when notes are ready.</string>
</dict>
</plist>
