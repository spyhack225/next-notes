<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Next Notes</string>
	<key>CFBundleDisplayName</key>
	<string>Next Notes</string>
	<!-- Deliberately space-free, and deliberately not just `Notes`: the executable's name is
	     what `pkill`/`killall` match on, so it is what a script or a developer types to stop
	     this app. `NextNotes` matches this process and nothing else, where `Notes` would also
	     take down Apple's Notes.app. -->
	<key>CFBundleExecutable</key>
	<string>NextNotes</string>
	<!-- Our own reverse-DNS. TCC grants and the preferences domain are both keyed on this
	     string, so changing it starts the app over with a clean slate: the permission prompts
	     come back, and `AppIdentity` folds the old `ai.pivotstudio.speechify` defaults in. -->
	<key>CFBundleIdentifier</key>
	<string>ai.pivotstudio.nextnotes</string>
	<!-- Shown in the About panel and in Finder's Get Info. AGPL-3.0-or-later: the full
	     text ships beside it as Resources/LICENSE.txt. -->
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Serge Kadjo. Licensed under the GNU Affero General Public License v3.0 or later.</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.2.22</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<!-- Lets the dashboard's Clear button call back into the app. A file:// page can't
	     write files or talk to a process, but it can follow a custom-scheme link. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ai.pivotstudio.nextnotes</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>nextnotes</string>
			</array>
		</dict>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<!-- A regular app: dock icon, app menu, standard windows. The menu bar item remains
	     for status and the hotkey while you're working elsewhere, but it is secondary. -->
	<key>LSUIElement</key>
	<false/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Next Notes listens while you hold the push-to-talk key so it can turn your speech into text.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Next Notes transcribes your speech on-device to insert text where you're typing.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Next Notes records what you hear during a meeting so it can transcribe the other participants on-device. Audio never leaves this Mac.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Next Notes reads your calendar to know when a meeting starts, so it can offer to take notes.</string>
	<key>NSUserNotificationsUsageDescription</key>
	<string>Next Notes notifies you before a meeting recording starts, when notes are ready, and when a reminder you set with the Agent is due.</string>
	<!-- Asked for only when the user adds one of these folders to the list their assistant
	     may look through. Only names, sizes and dates are read; file contents never are. -->
	<key>NSDesktopFolderUsageDescription</key>
	<string>Next Notes lists the names of what is on your Desktop so your assistant can find your files. It never reads what is inside them.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Next Notes lists the names of what is in your Documents folder so your assistant can find your files. It never reads what is inside them.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Next Notes lists the names of what is in your Downloads folder so your assistant can find your files. It never reads what is inside them.</string>
</dict>
</plist>
