<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Deliberately NOT sandboxed: a CGEventTap and system-wide AX access are both
	     impossible inside the App Sandbox. Distribution would be Developer ID, not MAS. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- llama.cpp ships as an official prebuilt framework. Ad-hoc development builds have
	     no stable Team ID, so hardened-runtime library validation otherwise rejects the
	     bundled framework even after both components are re-signed locally. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
