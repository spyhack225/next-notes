+final class VoiceInputProducerProbe: @unchecked Sendable {
+    struct Input: Sendable {
+        let sequence: Int
+        let frames: Range<Int>
+        let second: Bool
+    }
+    struct Event: Sendable {
+        let kind: String
+        let input: Input?
+        let epoch: Int?
+        let capturedEnd: Int
