+/// The runtime's streaming output producer. Owns the holdback before any callback.
+struct ChatTemplateStreamOutput {
+    let family: ChatTemplateFamily
+    let renderSpecial: Bool
+    private var pending = ""
+    private(set) var stopped = false
+
+    init(family: ChatTemplateFamily, renderSpecial: Bool) {
+        self.family = family
+        self.renderSpecial = renderSpecial
+    }
+
+    mutating func consume(_ input: String, yield: (String) -> Void) {
+        guard !stopped else { return }
+        let turnEnd = ChatTemplate.stopMarker(family)
+        var piece = input
+        if renderSpecial {
+            for marker in ChatTemplate.controlMarkers(family) where marker != turnEnd {
+                piece = piece.replacingOccurrences(of: marker, with: "")
+            }
+        }
+        pending += piece
+        let maxHeld = min(turnEnd.count, pending.count)
+        let held = maxHeld == 0 ? 0 : (1...maxHeld).reversed().first {
+            String(pending.suffix($0)) == String(turnEnd.prefix($0))
+        } ?? 0
+        let safeCount = pending.count - held
+        if safeCount > 0 {
+            yield(String(pending.prefix(safeCount)))
+            pending.removeFirst(safeCount)
+        }
+        if !turnEnd.isEmpty, pending == turnEnd {
+            pending = ""
+            stopped = true
+        }
+    }
+
+    mutating func finish(yield: (String) -> Void) {
+        let turnEnd = ChatTemplate.stopMarker(family)
+        if !pending.isEmpty, turnEnd.isEmpty || !pending.hasPrefix(turnEnd) { yield(pending) }
+        pending = ""
+    }
+}
