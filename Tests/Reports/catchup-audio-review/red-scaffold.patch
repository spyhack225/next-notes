+    var duration: TimeInterval = 10
+    var currentTime: TimeInterval = 2
+    var isPlaying = false
+    func prepareToPlay() -> Bool { true }
+    func play() -> Bool { isPlaying = true; return true }
+    func pause() { isPlaying = false }
