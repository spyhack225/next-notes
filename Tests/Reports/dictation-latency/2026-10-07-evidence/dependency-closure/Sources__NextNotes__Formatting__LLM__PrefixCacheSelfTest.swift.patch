+        check(successorRefusal == "live speech recognition holds the lane",
+              "successor still sees a retained native owner: " + successorRefusal)
+        check(deniedAdmission.value == 0, "refused successor enters native generation")
+        SelfTest.diagnostic("NATIVE_PARKED_CANCELLATION_OBSERVATION: joinedWhileASRHeld=\(releasedOwner) "
+            + "wait=\(began.duration(to: .now)) chunks=\(decodedChunks.value) "
