+            // Clearing on the same actor joins any currently executing observer.
+            await runtime.setPrefillChunkObserverForTesting(nil)
+            if let lateAcquisition = asrTask.value {
+                await ComputeScheduler.shared.release(await lateAcquisition.value)
+            }
+            _ = await producer.value
+            _ = await runtime.finishTermination()
+            SelfTest.diagnostic("NATIVE_PARKED_CANCELLATION_FAILED: native observer did not acquire ASR")
+            return false
+        }
+        let asrID = await acquisition.value
+        let parked = await awaitParkedCondition(within: .seconds(2)) {
+            await ComputeScheduler.shared.hasCheckpointWaiterForTesting(.realtimeAgent)
+        }
+        check(parked, "actual cleanup did not register its parked checkpoint")
+        let began = ContinuousClock.now
+        producer.cancel()
+        let releasedOwner = await awaitParkedCondition(within: .milliseconds(250)) { joined.value }
+        check(releasedOwner, "cancelled actual cleanup keeps its native owner until ASR releases")
+        let occupancy = await ComputeScheduler.shared.occupancy()
