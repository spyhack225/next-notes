+        let joined = LockedBox(false)
+        let phaseID = CommandLine.arguments.contains("--native-phase-observation") ? UUID() : nil
+        let operation: @MainActor @Sendable () async -> String = {
+            do {
+                _ = try await runtime.completeForDictationCleanup(file: file,
+                    system: system, user: user, maxTokens: generationBudget,
+                    admitted: { admitted.value += 1 })
+                return "completed"
+            } catch is CancellationError { return "cancelled" }
+            catch { return "error: " + error.localizedDescription }
+        }
+        let producer = Task {
+            defer { joined.value = true }
+            if let phaseID {
+                return await LatencyCorrelation.$current.withValue(LatencyCorrelation(workID: phaseID)) {
+                    await operation()
+                }
+            }
+            return await operation()
+        }
+        let observerReached = await awaitParkedCondition(within: .seconds(10)) { asrTask.value != nil }
+        guard observerReached, let acquisition = asrTask.value else {
