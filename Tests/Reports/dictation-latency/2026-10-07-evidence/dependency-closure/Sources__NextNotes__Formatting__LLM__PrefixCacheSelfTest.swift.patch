+              let initial, initial.promptTokens > 128 else {
+            _ = await runtime.finishTermination()
+            SelfTest.diagnostic("NATIVE_PARKED_CANCELLATION_FAILED: native warm/prompt precondition")
+            return false
+        }
+        await runtime.resetPrefixCacheForTesting()
+        let asrTask = LockedBox<Task<UUID, Never>?>(nil)
+        let decodedChunks = LockedBox(0)
+        await runtime.setPrefillChunkObserverForTesting {
+            decodedChunks.value += 1
+            if asrTask.value == nil {
+                asrTask.value = Task { await ComputeScheduler.shared.acquire(.realtimeASR) }
+            }
+        }
+        let file = await runtime.spec.fileURL
