+        check(await runtime.finishTermination(), "private native owner did not join termination")
+        for problem in failures { SelfTest.diagnostic("NATIVE_PARKED_CANCELLATION_WRONG: " + problem) }
+        SelfTest.diagnostic(failures.isEmpty ? "NATIVE_PARKED_CANCELLATION_OK"
+            : "NATIVE_PARKED_CANCELLATION_FAILED: \(failures.count) problem(s)")
+        return failures.isEmpty
+    }
+
+    private static func awaitParkedCondition(
+        within budget: Duration, _ condition: @escaping @Sendable () async -> Bool
+    ) async -> Bool {
+        let deadline = ContinuousClock.now.advanced(by: budget)
+        repeat {
+            if await condition() { return true }
+            try? await Task.sleep(for: .milliseconds(1))
+        } while ContinuousClock.now < deadline
+        return await condition()
+    }
