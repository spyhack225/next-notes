+    /// Exercise the same non-streaming entrance MiniCPM cleanup uses. Cancel only
+    /// after the last successful native prefill chunk, before any sampled output.
+    private static func dictationCancellationReuseFailures(
+        _ runtime: NotesModelRuntime, system: String, user: String, promptTokens: Int
+    ) async -> [String] {
+        await runtime.resetPrefixCacheForTesting()
+        let probe = PrefixCacheCancellationProbe(atChunk: (promptTokens + 127) / 128)
+        await runtime.setPrefillChunkObserverForTesting { probe.decoded() }
+        let file = await runtime.spec.fileURL
+        let admitted = LockedBox(0)
+        // The observer cancels its current task; give this call its own task so the
+        // fixture's cleanup and successor remain active and can join this producer.
+        let cancelled = Task {
+            do {
+                _ = try await runtime.completeForDictationCleanup(
+                    file: file, system: system, user: user, maxTokens: generationBudget,
+                    admitted: { admitted.value += 1 })
+                return false
+            } catch is CancellationError { return true }
+            catch { return false }
+        }
+        let didCancel = await cancelled.value
+        await runtime.setPrefillChunkObserverForTesting(nil)
+        guard probe.didCancel, didCancel, admitted.value == 1 else {
+            return ["actual dictation generation did not cancel after successful native prefill"]
+        }
+        do {
+            let successor = try await runtime.completeForDictationCleanup(
+                file: file, system: system, user: user, maxTokens: generationBudget, admitted: {})
+            guard let stats = await runtime.prefillStatsForTesting() else {
+                return ["cancelled dictation successor has no native prefill counters"]
+            }
+            var failures: [String] = []
+            if stats.reused != stats.promptTokens - 1 || stats.decoded != 1 {
+                failures.append("cancelled dictation discarded native-success prefix: reused\(stats.reused), expected\(stats.promptTokens - 1)")
+            }
+            await runtime.resetPrefixCacheForTesting()
+            let control = try await runtime.completeForDictationCleanup(
+                file: file, system: system, user: user, maxTokens: generationBudget, admitted: {})
+            if successor.completion.text.isEmpty
+                || successor.completion.text != control.completion.text {
+                failures.append("cancelled dictation successor differs from the actual cleared-context control")
+            }
+            return failures
+        } catch {
+            return ["cancelled dictation successor failed: \(error.localizedDescription)"]
+        }
+    }
