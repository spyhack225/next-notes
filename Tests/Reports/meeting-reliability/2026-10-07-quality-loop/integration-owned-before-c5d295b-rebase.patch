+/// paraphrases. IDs are local to this one generation; nothing is stored or looked up.
+enum NotesEvidence {
+    struct Source: Sendable {
+        let id: Int
+        let text: String
+        let prefix: String
+        var line: String { prefix + text }
+    }
+
+    struct Entry: Codable, Equatable, Sendable {
+        let source: Int
+        let quote: String
+    }
+
+    struct Admission: Sendable {
+        let entries: [Entry]
+        let incomplete: Bool
+    }
