diff --git a/Sources/NextNotes/Meetings/MeetingPerformanceSummary.swift b/Sources/NextNotes/Meetings/MeetingPerformanceSummary.swift
new file mode 100644
index 0000000..c172967
--- /dev/null
+++ b/Sources/NextNotes/Meetings/MeetingPerformanceSummary.swift
@@ -0,0 +1,103 @@
+import Foundation
+
+/// Bounded observations retained on the existing meeting record. Peaks are sampled
+/// values, not a continuous trace or allocation attribution. No per-sample history.
+struct MeetingPerformanceSummary: Codable, Sendable, Equatable {
+    let recordingStartedAt: Date
+    private(set) var samples = 0
+    private(set) var footprintSamples = 0
+    private(set) var firstSampleAt: Date?
+    private(set) var lastSampleAt: Date?
+    private(set) var maximumSampleGapSeconds: Double = 0
+    private(set) var peakSampledFootprintBytes: UInt64?
+    private(set) var peakSampledResidentBytes: UInt64?
+    private(set) var peakQueuedBytes = 0
+    private(set) var peakActiveBytes = 0
+    private(set) var pausedSamples = 0
+
+    init(recordingStartedAt: Date) {
+        self.recordingStartedAt = recordingStartedAt
+    }
+
+    // MeetingStore's ISO8601 strategy drops fractional seconds. These new clock
+    // facts must survive that boundary exactly: otherwise fresh readers lose sample
+    // precision and the same recording no longer matches its older metadata writer.
+    // Reference-date doubles retain Date's native precision without changing any
+    // existing meeting timestamps or the enclosing store's encoding strategy.
+    private enum CodingKeys: String, CodingKey {
+        case recordingStartedAtReferenceSeconds, firstSampleReferenceSeconds, lastSampleReferenceSeconds
+        case recordingStartedAt, firstSampleAt, lastSampleAt // early diagnostic representation
+        case samples, footprintSamples, maximumSampleGapSeconds
+        case peakSampledFootprintBytes, peakSampledResidentBytes
+        case peakQueuedBytes, peakActiveBytes, pausedSamples
+    }
+
+    init(from decoder: any Decoder) throws {
+        let c = try decoder.container(keyedBy: CodingKeys.self)
+        if let seconds = try c.decodeIfPresent(Double.self, forKey: .recordingStartedAtReferenceSeconds) {
+            recordingStartedAt = Date(timeIntervalSinceReferenceDate: seconds)
+        } else {
+            recordingStartedAt = try c.decode(Date.self, forKey: .recordingStartedAt)
+        }
+        func date(_ precise: CodingKeys, _ legacy: CodingKeys) throws -> Date? {
+            if let seconds = try c.decodeIfPresent(Double.self, forKey: precise) {
+                return Date(timeIntervalSinceReferenceDate: seconds)
+            }
+            return try c.decodeIfPresent(Date.self, forKey: legacy)
+        }
+        firstSampleAt = try date(.firstSampleReferenceSeconds, .firstSampleAt)
+        lastSampleAt = try date(.lastSampleReferenceSeconds, .lastSampleAt)
+        samples = try c.decode(Int.self, forKey: .samples)
+        footprintSamples = try c.decode(Int.self, forKey: .footprintSamples)
+        maximumSampleGapSeconds = try c.decode(Double.self, forKey: .maximumSampleGapSeconds)
+        peakSampledFootprintBytes = try c.decodeIfPresent(UInt64.self, forKey: .peakSampledFootprintBytes)
+        peakSampledResidentBytes = try c.decodeIfPresent(UInt64.self, forKey: .peakSampledResidentBytes)
+        peakQueuedBytes = try c.decode(Int.self, forKey: .peakQueuedBytes)
+        peakActiveBytes = try c.decode(Int.self, forKey: .peakActiveBytes)
+        pausedSamples = try c.decode(Int.self, forKey: .pausedSamples)
+    }
+
+    func encode(to encoder: any Encoder) throws {
+        var c = encoder.container(keyedBy: CodingKeys.self)
+        try c.encode(recordingStartedAt.timeIntervalSinceReferenceDate, forKey: .recordingStartedAtReferenceSeconds)
+        try c.encodeIfPresent(firstSampleAt?.timeIntervalSinceReferenceDate, forKey: .firstSampleReferenceSeconds)
+        try c.encodeIfPresent(lastSampleAt?.timeIntervalSinceReferenceDate, forKey: .lastSampleReferenceSeconds)
+        try c.encode(samples, forKey: .samples)
+        try c.encode(footprintSamples, forKey: .footprintSamples)
+        try c.encode(maximumSampleGapSeconds, forKey: .maximumSampleGapSeconds)
+        try c.encodeIfPresent(peakSampledFootprintBytes, forKey: .peakSampledFootprintBytes)
+        try c.encodeIfPresent(peakSampledResidentBytes, forKey: .peakSampledResidentBytes)
+        try c.encode(peakQueuedBytes, forKey: .peakQueuedBytes)
+        try c.encode(peakActiveBytes, forKey: .peakActiveBytes)
+        try c.encode(pausedSamples, forKey: .pausedSamples)
+    }
+
+    mutating func observe(at date: Date, process: ProcessSnapshot,
+                         queuedBytes: Int, activeBytes: Int, paused: Bool) {
+        // A clock moving backwards must not fabricate coverage or erase prior peaks.
+        guard date >= recordingStartedAt, lastSampleAt.map({ date >= $0 }) ?? true else { return }
+        maximumSampleGapSeconds = max(maximumSampleGapSeconds,
+            date.timeIntervalSince(lastSampleAt ?? recordingStartedAt))
+        firstSampleAt = firstSampleAt ?? date
+        lastSampleAt = date
+        samples += 1
+        if let footprint = process.physicalFootprintBytes {
+            footprintSamples += 1
+            peakSampledFootprintBytes = max(peakSampledFootprintBytes ?? footprint, footprint)
+        }
+        if let resident = process.residentMemoryBytes {
+            peakSampledResidentBytes = max(peakSampledResidentBytes ?? resident, resident)
+        }
+        peakQueuedBytes = max(peakQueuedBytes, max(0, queuedBytes))
+        peakActiveBytes = max(peakActiveBytes, max(0, activeBytes))
+        if paused { pausedSamples += 1 }
+    }
+
+    /// Other existing metadata writers may hold an older meeting value. Preserve
+    /// the latest aggregate from the same recording; never sum replayed snapshots.
+    func preserving(_ stored: Self?) -> Self {
+        guard let stored, stored.recordingStartedAt == recordingStartedAt,
+              stored.samples > samples else { return self }
+        return stored
+    }
+}
diff --git a/Sources/NextNotes/Meetings/MeetingPerformanceSummarySelfTest.swift b/Sources/NextNotes/Meetings/MeetingPerformanceSummarySelfTest.swift
new file mode 100644
index 0000000..18c2d1a
--- /dev/null
+++ b/Sources/NextNotes/Meetings/MeetingPerformanceSummarySelfTest.swift
@@ -0,0 +1,94 @@
+import Foundation
+
+@MainActor
+enum MeetingPerformanceSummarySelfTest {
+    static func run(write: (String) -> Void) async -> Bool {
+        var failures: [String] = []
+        var checks = 0
+        func check(_ name: String, _ value: Bool) {
+            checks += 1
+            if !value { failures.append(name) }
+        }
+        let began = Date()
+        var sample = ProcessSnapshot.current()
+        sample.physicalFootprintBytes = 900_000_000
+        sample.residentMemoryBytes = 600_000_000
+        var summary = MeetingPerformanceSummary(recordingStartedAt: began)
+        for index in 1...700 {
+            sample.physicalFootprintBytes = index == 350 ? 1_200_000_000 : 900_000_000
+            summary.observe(at: began.addingTimeInterval(Double(index) * 10),
+                process: sample, queuedBytes: index == 300 ? 40_000 : 0,
+                activeBytes: 448_000, paused: index == 200)
+        }
+        check("middle observation survives beyond 512 rows", summary.samples == 700
+            && summary.peakSampledFootprintBytes == 1_200_000_000)
+        check("coverage and gap retained", summary.firstSampleAt == began.addingTimeInterval(10)
+            && summary.lastSampleAt == began.addingTimeInterval(7000)
+            && summary.maximumSampleGapSeconds == 10)
+        check("queue, active and pause counters retained", summary.peakQueuedBytes == 40_000
+            && summary.peakActiveBytes == 448_000 && summary.pausedSamples == 1)
+        sample.physicalFootprintBytes = nil
+        summary.observe(at: began.addingTimeInterval(7095), process: sample,
+                        queuedBytes: 0, activeBytes: 0, paused: false)
+        check("unobserved interval is visible", summary.maximumSampleGapSeconds == 95)
+        check("failed memory query stays unknown", summary.samples == 701
+            && summary.footprintSamples == 700 && summary.peakSampledFootprintBytes == 1_200_000_000)
+        let accepted = summary
+        summary.observe(at: began.addingTimeInterval(5), process: sample,
+                        queuedBytes: .max, activeBytes: .max, paused: true)
+        check("backward time supplies no coverage", summary == accepted)
+        do {
+            let store = MeetingStore.isolated()
+            let root = store.directory(for: UUID()).deletingLastPathComponent()
+            defer { try? FileManager.default.removeItem(at: root) }
+            let original = Meeting(title: "Performance coverage fixture", start: began, status: .recording)
+            check("fixture saved", store.save(original))
+            let session = MeetingSession(meeting: original, store: store,
+                                         captureHub: AudioCaptureHub(probe: true))
+            let safe = MeetingDiskCapacity(immediateBytes: 10_000_000_000,
+                                           importantBytes: 10_000_000_000)
+            // The real existing health/sample/metadata path; no microphone/model starts.
+            await session.checkResourceHealth(now: began.addingTimeInterval(1),
+                                              capacityForTesting: safe, criticalForTesting: false)
+            await session.checkResourceHealth(now: began.addingTimeInterval(2),
+                                              capacityForTesting: safe, criticalForTesting: false)
+            let loaded = store.freshReaderForTesting().meeting(id: original.id)
+            check("actual session emits persisted observations", loaded?.performanceSummary?.samples == 2
+                && loaded?.performanceSummary?.lastSampleAt.map { $0 >= began && $0 <= Date() } == true)
+            check("actual sample retains footprint independently of RSS",
+                  loaded?.performanceSummary?.peakSampledFootprintBytes != nil
+                    && loaded?.performanceSummary?.peakSampledResidentBytes != nil)
+            check("older metadata save admitted", store.save(original))
+            check("older nil snapshot cannot erase coverage",
+                  store.freshReaderForTesting().meeting(id: original.id)?.performanceSummary == loaded?.performanceSummary)
+            var newer = original
+            newer.performanceSummary = accepted
+            check("long aggregate saved", store.save(newer))
+            var stale = original
+            stale.performanceSummary = MeetingPerformanceSummary(recordingStartedAt: began)
+            check("older nonnil snapshot admitted", store.save(stale))
+            check("stale snapshot cannot erase middle peak",
+                  store.freshReaderForTesting().meeting(id: original.id)?.performanceSummary == accepted)
+            let restartedWriter = store.freshReaderForTesting()
+            check("fresh writer admits older metadata", restartedWriter.save(stale))
+            check("persisted clock still binds the same recording",
+                  restartedWriter.freshReaderForTesting().meeting(id: original.id)?.performanceSummary == accepted)
+            let encoder = JSONEncoder()
+            let decoder = JSONDecoder()
+            let encoded = try encoder.encode(newer)
+            var object = try JSONSerialization.jsonObject(with: encoded) as! [String: Any]
+            object.removeValue(forKey: "performanceSummary")
+            let legacy = try decoder.decode(Meeting.self,
+                from: JSONSerialization.data(withJSONObject: object))
+            check("legacy meeting remains readable with unknown coverage", legacy.id == newer.id
+                && legacy.performanceSummary == nil)
+            let direct = try decoder.decode(Meeting.self, from: encoded)
+            check("full aggregate round trips", direct.performanceSummary == accepted)
+            check("aggregate storage stays bounded", try encoder.encode(accepted).count < 2000)
+        } catch { failures.append(error.localizedDescription) }
+        for failure in failures { write("MEETING_PERFORMANCE_WRONG: \(failure)") }
+        write(failures.isEmpty ? "MEETING_PERFORMANCE_OK: \(checks) actual-session/persistence and bounded-coverage checks"
+                              : "MEETING_PERFORMANCE_FAILED: \(failures.count)/\(checks)")
+        return failures.isEmpty
+    }
+}
