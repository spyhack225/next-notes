+    private var invitedNames: [String] { Self.invitedNames(suggestions) }
+
+    /// Display choices only: duplicate strings do not identify duplicate people.
+    static func invitedNames(_ suggestions: [String]) -> [String] {
+        var seen = Set<String>()
+        return suggestions.compactMap { value in
+            let name = value.trimmingCharacters(in: .whitespacesAndNewlines)
+            guard !name.isEmpty, seen.insert(name).inserted else { return nil }
+            return name
+        }
+    }
+
+    /// The per-row button and isolated save fixture use this same draft producer.
+    /// No attendance, voice or email association is inferred from an invitation.
+    @discardableResult
+    static func chooseInvitedName(_ name: String, for label: String,
+                                 labels: [String], suggestions: [String],
+                                 names: inout [String: String]) -> Bool {
+        guard labels.contains(label), invitedNames(suggestions).contains(name) else { return false }
+        names[label] = name
+        return true
+    }
+
